{
  "name": "fa-hr-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "tsx server/index.ts --prod",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "express": "^4.21.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22",
    "concurrently": "^9",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6"
  }
}
